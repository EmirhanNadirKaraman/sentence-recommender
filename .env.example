# This project's own Postgres database — everything reads and writes it,
# and `alembic upgrade head` builds it. Create it once with:
#   psql -U postgres -c "CREATE DATABASE sentence_recommender OWNER <user>;"
DB_NAME=sentence_recommender
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Which browser yt-dlp may borrow a YouTube session from: chrome, safari,
# firefox, edge, brave, opera. Leave unset until a scrape is refused with
# "Sign in to confirm you're not a bot" — it reads your own browser cookies.
YTDLP_COOKIES_BROWSER=

# The local model, for `fill-gaps`. Unset means those paths refuse rather
# than silently degrading.
LLM_BASE_URL=
LLM_MODEL=
