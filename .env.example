# This project's own Postgres database — everything reads and writes it,
# and `alembic upgrade head` builds it. Create it once with:
#   psql -U postgres -c "CREATE DATABASE sentence_recommender OWNER <user>;"
DB_NAME=sentence_recommender
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Which browser yt-dlp may borrow a YouTube session from: chrome, safari,
# firefox, edge, brave, opera. Leave unset until a scrape is refused with
# "Sign in to confirm you're not a bot" — it reads your own browser cookies.
YTDLP_COOKIES_BROWSER=

# The local model, for `fill-gaps`. Unset means those paths refuse rather
# than silently degrading.
LLM_BASE_URL=https://<your-cloudflare-url>/v1
LLM_MODEL=<the model name>
LLM_API_KEY=<the password>
LLM_AUTH=bearer

# Signing in with Google (README, "Signing in with Google"). All three or no
# Google button: the client id and secret from the Google Cloud console, and
# the address readers type -- Google sends them back there and nowhere else,
# e.g. http://localhost:8765 or https://<machine>.<tailnet>.ts.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=

# How many readers may sign up on their own with Google; 0 closes sign-up.
# Invitations do not count. Each reader reading holds about 250 MB.
SIGNUP_LIMIT=10
