.env
__pycache__/

# macOS writes one of these into every folder it has been looked at in.
.DS_Store
*.pyc
.venv/
data/state.sqlite3

# Imported once, kept, and read by nothing. Moved out of the working
# database because it was half the bytes of every cold read.
data/tatoeba.sqlite3

# WAL sidecars — they come and go with the database, which is already ignored
data/state.sqlite3-shm
data/state.sqlite3-wal

# Derived: rebuilt whenever the vocabulary files or the analyser change
data/resolved.json

# Source material for `build-corpus transcript`, not source code: 1,413
# transcript files someone else wrote and published. What this project makes
# of them — the analysed sentences — lives in data/state.sqlite3, which is
# ignored too. Point `--path` elsewhere if you keep them somewhere else.
Easy German Transcripts/

# Runtime log from `backfill-channels`, regenerated on every run.
backfill.log

# Symlink to this session scratchpad, where the background job logs land.
logs

# Corpus dumps to restore from. Handed to you, not committed.
dump/

# Generated from the stored plan and rebuildable from it: the audio, a still
# per card, the episodes those two make together, and the Anki packages.
# Gigabytes, none of it authored here. The rest of out/ is run logs and is
# tracked.
#
# The documents, but not the sheet they are made from. git keeps whole copies
# of a binary rather than deltas, so committing a rebuild costs 11.5 MB
# whether one card moved or three thousand did, and the diff says nothing a
# person can read. `out/deck/*.tsv` is the same deck as text: a rebuild that
# moves 5% of it is a 5% diff, and `export-deck --from` turns it back into
# both documents on a machine with no corpus, no Postgres and no model.
out/deck/*.pdf
out/deck/*.pptx
out/deck/*.epub
out/audio/
out/stills/
out/episodes/
out/anki/

# Piper voices, fetched on first use of `speak-deck`. ~60 MB of ONNX that
# belongs to whoever trained it, not to this repository.
data/voices/

# What `gloss-deck` appends as it runs, so a long job can be tailed. Its
# contents are in the state database as well; this is the readable copy.
out/gloss.log
out/speak.log
out/translate.log

# Where long runs write their logs, so they are findable next to the output
# they produced rather than in a session temp directory that holds every log
# since the project started. Ignored for the same reason as the two above:
# whatever they say that matters is in the database or in the deck.
out/logs/
out/ask.log
